# Two ways to give cloud its OpenRouter key. Pick one.

# 1) Environment variable (recommended — works on Render/Railway/VPS):
#    OPENROUTER_API_KEY=sk-or-v1-...

# 2) A file next to the bot's data (gitignored):
#    create <DATA_DIR>/openrouter.key  containing just the key, one line, e.g.
#    echo 'sk-or-v1-...' > data/openrouter.key

# Never commit a real key: GitHub's push protection will reject it, and anyone
# who can read the repo could spend against it.
